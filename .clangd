# Linux 下 clangd 配置（测试分支）
#
# 编译数据库里的目标为裸机 ARM(--target=arm-none-eabi)，clangd 不会去宿主系统找
# libc 头文件，因此 math.h 等标准库头需要显式指向 arm-none-eabi-gcc 工具链的
# newlib / GCC 内建头文件目录。
#
# 注: 路径中的 13.2.1 是工具链版本号，升级 gcc-arm-none-eabi 后需同步更新。
CompileFlags:
  Add:
    - -isystem/usr/lib/gcc/arm-none-eabi/13.2.1/include
    - -isystem/usr/lib/gcc/arm-none-eabi/13.2.1/include-fixed
    - -isystem/usr/lib/arm-none-eabi/include
