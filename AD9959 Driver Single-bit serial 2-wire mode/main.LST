   14          int putchar(unsigned long ch)  {                   /* Write character to Serial Port  */
   15   1      
   16   1          while(!(0x020==(COMSTA0 & 0x020)))
   17   1          {}
   18   1       
   19   1          return (COMTX = ch);    //COMTX is an 8-bit transmit register.
   20   1      }
   21          
   22          void main(void)
   23          {
   24   1          ADuC7026_Initiate();        //ADuC7026 Initialization
   25   1      
   26   1          RegisterData[0] = 0x10;     //Channel 0 enable
   27   1          WriteToAD9959ViaSpi(0x00,1,RegisterData);
   28   1      
