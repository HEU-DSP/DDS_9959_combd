   34   1          RegisterData[3] = 0x05;
   35   1          RegisterData[2] = 0x1E;
   36   1          RegisterData[1] = 0xB8;
   37   1          RegisterData[0] = 0x51;
   38   1          WriteToAD9959ViaSpi(0x04,4,RegisterData);//Output frequency = 10MHz 
   39   1      
   40   1          IO_Update();
   41   1      
   42   1          ReadFromAD9959ViaSpi(0x80,1,RegisterData);
   43   1          putchar(RegisterData[0]);
   44   1          ReadFromAD9959ViaSpi(0x81,3,RegisterData);
   45   1          putchar(RegisterData[2]);
   46   1          putchar(RegisterData[1]);
   47   1          putchar(RegisterData[0]);
   48   1          while(1)
   49   1          {;}
   50   1      }
